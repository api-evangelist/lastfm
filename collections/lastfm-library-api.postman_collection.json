          "name": "Invoke A Read Method",
          "request": {
            "name": "Invoke A Read Method",
            "description": {
              "content": "Single read-side dispatch endpoint. The `method` parameter selects the\noperation (e.g. `album.getInfo`, `artist.getTopTracks`, `chart.getTopArtists`).\nUse `format=json` for JSON responses.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "method",
                  "value": "<string>",
                  "description": "(Required) Method name in `package.method` format (e.g. `track.getInfo`,\n`chart.getTopArtists`, `user.getRecentTracks`).\n"
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your Last.fm API key."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml",
                  "description": "Response format. Defaults to XML."
                },
                {
                  "disabled": false,
                  "key": "callback",
                  "value": "<string>",
                  "description": "Optional JSONP callback function name when `format=json`."
                },
                {
                  "disabled": false,
                  "key": "artist",
                  "value": "<string>",
                  "description": "Artist name (used by album.*, artist.*, track.* read methods)."
                },
                {
                  "disabled": false,
                  "key": "album",
                  "value": "<string>",
                  "description": "Album name (used by album.* methods)."
                },
                {
                  "disabled": false,
                  "key": "track",
